{
  "name": "crapstv",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "A living-room craps table. TV is the table. Phones are the chips.",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build && node scripts/finalize-build.mjs",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write src server tests scripts/*.mjs *.js *.json *.html .github/workflows/*.yml",
    "test:online": "node scripts/check-online.mjs",
    "test:odds": "node tests/phone-odds.browser.mjs",
    "benchmark": "node scripts/benchmark-render.mjs",
    "test:graphics": "node tests/graphics.browser.mjs",
    "test:payout": "node tests/phone-payout.browser.mjs",
    "test:layout": "node tests/phone-layout.browser.mjs",
    "test:learn": "node tests/learn-center.browser.mjs",
    "test:tv": "node tests/tv-readability.browser.mjs && node tests/join-card.browser.mjs",
    "test:tour": "node tests/tour-camera.browser.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@homebridge/ciao": "1.4.0",
    "cannon-es": "^0.20.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
